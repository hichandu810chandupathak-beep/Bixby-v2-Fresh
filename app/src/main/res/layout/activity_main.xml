<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="@drawable/bixby_background_gradient" android:layout_height="match_parent" android:layout_width="match_parent" android:padding="24dp" xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Top Bar -->
    <LinearLayout android:gravity="center_vertical" android:id="@+id/topBar" android:layout_alignParentTop="true" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:orientation="horizontal">
        <TextView android:fontFamily="sans-serif-medium" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Bixby" android:textColor="@color/bixby_text_primary" android:textSize="22sp" android:textStyle="bold"/>
        <View android:layout_height="0dp" android:layout_weight="1" android:layout_width="0dp"/>
        <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:letterSpacing="0.15" android:text="AI ASSISTANT" android:textColor="@color/bixby_text_secondary" android:textSize="12sp"/>
    </LinearLayout>

    <!-- Center Glowing Orb and Greeting -->
    <LinearLayout android:gravity="center" android:layout_centerInParent="true" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_height="160dp" android:layout_marginBottom="32dp" android:layout_width="160dp">
            <View android:background="@drawable/bixby_orb_glow" android:layout_height="match_parent" android:layout_width="match_parent"/>
            <View android:background="@drawable/bixby_orb_core" android:layout_gravity="center" android:layout_height="90dp" android:layout_width="90dp"/>
        </FrameLayout>
        <TextView android:fontFamily="sans-serif-medium" android:id="@+id/greetingText" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="wrap_content" android:text="Hi, how can I help?" android:textColor="@color/bixby_text_primary" android:textSize="26sp" android:textStyle="bold"/>
        <TextView android:fontFamily="sans-serif" android:id="@+id/statusText" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Ready" android:textColor="@color/bixby_text_secondary" android:textSize="15sp"/>
    </LinearLayout>

    <!-- Bottom Mic Control Bar -->
    <LinearLayout android:background="@drawable/bixby_bottom_bar_bg" android:gravity="center_vertical" android:layout_alignParentBottom="true" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:orientation="horizontal" android:paddingHorizontal="20dp" android:paddingVertical="12dp">
        <TextView android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="Tap the mic to speak" android:textColor="@color/bixby_text_secondary" android:textSize="14sp"/>
        <ImageButton android:background="@drawable/bixby_mic_button_bg" android:contentDescription="Mic" android:elevation="4dp" android:id="@+id/micButton" android:layout_height="56dp" android:layout_width="56dp" android:padding="14dp" android:src="@android:drawable/ic_btn_speak_now" android:tint="#FFFFFF"/>
    </LinearLayout>

</RelativeLayout>